{
  "manifest_version": 3,
  "name": "Smart Student Registration Autofill",
  "version": "1.0.0",
  "description": "Fill student registration forms across multiple websites using Excel data.",
  "permissions": ["storage", "activeTab", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Smart Student Autofill"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/storage.js",
        "shared/matching.js",
        "shared/validation.js",
        "shared/adapters/generic.js",
        "shared/adapters/registry.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/xlsx.full.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}