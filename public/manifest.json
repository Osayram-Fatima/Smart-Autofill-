{
  "manifest_version": 3,
  "name": "Smart Form Autofill",
  "description": "Fill registration forms across multiple websites using Excel data.",
  "version": "1.0.0",
  "permissions": ["storage", "activeTab", "sidePanel"],
  "host_permissions": ["<all_urls>"],

  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },

  "action": {
    "default_title": "Smart Student Autofill",
    "default_icon": "icon.png"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/storage.js",
        "shared/matching.js",
        "shared/validation.js",
        "shared/adapters/generic.js",
        "shared/adapters/registry.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/xlsx.full.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
